# Frontend (Vite) environment variables
# Copy this file to .env.local for local development.
# Only VITE_-prefixed variables are exposed to the browser bundle.

# Base URL of the deployed Cloudflare Worker API.
# Leave empty during early frontend development to use local seed data.
VITE_API_BASE_URL=

# Public site URL, used for canonical links and sitemap generation.
VITE_SITE_URL=https://icebrim.com
