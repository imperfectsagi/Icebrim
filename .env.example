# Frontend (Vite) environment variables
# Copy this file to .env.local for local development.
# Only VITE_-prefixed variables are exposed to the browser bundle.

# Base URL of the deployed Cloudflare Worker API.
# Leave empty during early frontend development to use local seed data.
VITE_API_BASE_URL=

# Public site URL, used for canonical links and sitemap generation.
VITE_SITE_URL=https://icebrim.com

# Stripe PUBLISHABLE key (safe to expose client-side -- this is what
# "publishable" means; it cannot move money on its own). Required for the
# checkout page's card payment step to render. Get this from the Stripe
# Dashboard > Developers > API keys. Do NOT put the secret key here --
# that goes server-side only, via `wrangler secret put STRIPE_SECRET_KEY`
# (see workers/wrangler.toml).
VITE_STRIPE_PUBLISHABLE_KEY=
